# 백엔드 주소 — 서버(route handler 프록시)에서만 쓴다. 브라우저는 BE를 직접 부르지 않으므로 NEXT_PUBLIC_ 아님
API_BASE_URL=https://api-develop.landit.im

# 사이드바 서버 카드에 표시할 호스트 (비밀 아님). 비우면 API_BASE_URL의 호스트를 쓴다
NEXT_PUBLIC_API_HOST=

# 소셜 로그인 — 사용자 웹과 같은 client_id(BE LANDIT_AUTH_OIDC_*_AUDIENCES와 일치해야 한다). redirect URI는 각 콘솔에 등록
# 구글 — Google Cloud Console의 "웹" OAuth 클라이언트
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 선택 — 클라이언트 유형이 secret을 요구할 때만. PKCE 전용이면 비워둔다. 서버 전용
GOOGLE_CLIENT_SECRET=
# 미설정 시 현재 origin 기준 /auth/google/callback
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=
# 카카오 — 카카오 개발자 콘솔에서 OpenID Connect 활성화 필요
NEXT_PUBLIC_KAKAO_JS_KEY=
# code→id_token 교환용 REST 키. 공개돼도 되는 값이지만 서버에서만 쓴다
NEXT_PUBLIC_KAKAO_REST_API_KEY=
# 선택 — 카카오 콘솔에서 client secret을 켰을 때만. 서버 전용
KAKAO_CLIENT_SECRET=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=

# 콘텐츠 이미지가 올라가고 내려오는 곳 (S3·CloudFront). 쉼표로 여러 개.
# CSP의 img-src·connect-src에만 더해진다 — 비우면 편지 이미지 업로드가 브라우저에서 막힌다
CONTENT_IMAGE_ORIGINS=https://*.cloudfront.net
