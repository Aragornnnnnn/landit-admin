# 백엔드 주소 — 서버(route handler 프록시)에서만 쓴다. 브라우저는 BE를 직접 부르지 않으므로 NEXT_PUBLIC_ 아님
API_BASE_URL=https://api-develop.landit.im

# 사이드바 서버 카드에 표시할 호스트 (비밀 아님). 비우면 API_BASE_URL의 호스트를 쓴다
NEXT_PUBLIC_API_HOST=

# 아래는 뒤 PR에서 채운다 —
# 소셜 로그인: NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID · NEXT_PUBLIC_KAKAO_JS_KEY · NEXT_PUBLIC_KAKAO_REST_API_KEY · KAKAO_CLIENT_SECRET(서버 전용)
# Sentry: NEXT_PUBLIC_SENTRY_DSN · SENTRY_ORG · SENTRY_PROJECT · SENTRY_AUTH_TOKEN(서버 전용, Vercel에만)
